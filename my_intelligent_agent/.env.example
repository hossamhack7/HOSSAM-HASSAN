# Gemini API Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL_NAME="gemini-1.5-flash-latest" # Or your preferred default model
GEMINI_DEFAULT_TEMPERATURE="0.7" # Example: 0.1 to 1.0

# Server Configuration
FLASK_RUN_PORT=5000
LOG_LEVEL=INFO # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Agent Configuration
MCP_MODEL_ID="mcp-agent-v1" # Model ID for Open WebUI

# Filesystem Tool Configuration (Leave empty if not immediately needed or using defaults)
# DOCKER_FS_IMAGE_NAME="my-fs-tool:latest"
# ALLOWED_MOUNTS_CONFIG_JSON='{"sa3d_files": {"host_path": "/path/to/your/allowed/folder", "read_only": false}}'

# Self-Development (placeholders)
# SAVE_SUCCESSFUL_SANDBOX_OUTPUT=false
# SELF_DEV_OUTPUT_DIR="agent_outputs/self_dev_successful"
